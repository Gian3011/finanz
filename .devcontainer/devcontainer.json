{
  "name": "FinanZ (Java 17 + MySQL 8)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true"
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "FinanZ",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "cd Sistema && mvn -q -DskipTests package",
  // Arranca FinanZ en segundo plano cada vez que el Codespace se enciende,
  // aunque no haya una ventana de VS Code abierta.
  "postStartCommand": "setsid nohup bash .devcontainer/iniciar.sh > /tmp/finanz.log 2>&1 < /dev/null &",
  // Al abrir VS Code se muestra el registro del servidor.
  "postAttachCommand": "tail -n 30 -f /tmp/finanz.log",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack"]
    }
  }
}
