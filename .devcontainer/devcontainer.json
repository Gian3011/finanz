{
  "name": "FinanZ (Java 17 + MySQL 8)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true"
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "FinanZ",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "cd Sistema && mvn -q -DskipTests package",
  // Al abrir el Codespace se inicia FinanZ en segundo plano, desacoplado de la
  // terminal: sigue corriendo aunque se cierre VS Code (registro: /tmp/finanz.log).
  // Si ya está corriendo, iniciar.sh no hace nada.
  "postAttachCommand": "setsid nohup bash .devcontainer/iniciar.sh > /tmp/finanz.log 2>&1 < /dev/null &",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack"]
    }
  }
}
