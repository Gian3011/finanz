{
  "name": "FinanZ (Java 17 + MySQL 8)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true"
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "FinanZ",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "cd Sistema && mvn -q -DskipTests package",
  "postAttachCommand": "bash .devcontainer/iniciar.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack"]
    }
  }
}
